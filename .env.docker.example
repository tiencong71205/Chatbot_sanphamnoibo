# Docker deployment — Ollama and Qdrant accessible via host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

QDRANT_URL=http://host.docker.internal:6333
QDRANT_COLLECTION=vhomenex_products_v2

EMBEDDING_DIMENSION=1024

DENSE_TOP_K=15
SPARSE_TOP_K=15
FUSION_TOP_K=10
FINAL_TOP_K=6
RRF_K=60

CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=750
CHUNK_OVERLAP_TOKENS=60

OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=700
OLLAMA_TEMPERATURE=0.15

MIN_DENSE_SCORE=0.25
MAX_CONTEXT_TOKENS=5500

DATA_DIRECTORY=/app/data/raw
PROCESSED_DIRECTORY=/app/data/processed
BM25_INDEX_PATH=/app/storage/bm25/index.joblib

API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://backend:8000
LOG_LEVEL=INFO
